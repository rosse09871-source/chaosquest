# ==========================================
# ⚙️ ChaosQuest Environment Config Template
# Copy this file to .env and adjust as needed.
# DO NOT COMMIT THE ACTUAL .env FILE!
# ==========================================

# Database Connection (SQLite default for local, PostgreSQL for production)
DATABASE_URL=sqlite:///data/chaosquest.db
# DATABASE_URL=postgresql://chaos_user:YOUR_DB_PASSWORD@localhost:5432/chaosquest

# Session & Container Lifecycles
SESSION_TTL_SECONDS=1800
CONTAINER_MEM_LIMIT=256m
CONTAINER_CPU_LIMIT=0.5

# Server & Security
CHAOS_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
CHAOS_PORT=8080
